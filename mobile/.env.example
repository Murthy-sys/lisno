# Public runtime configuration. These values are bundled in the app; never put secrets here.
EXPO_PUBLIC_API_ENV=remote
EXPO_PUBLIC_REMOTE_API_URL=
# EXPO_PUBLIC_LOCAL_API_URL=http://10.0.2.2:3000/api/v1

# Build-only controls. Cleartext local HTTP is allowed only in development/internal builds.
LISNO_APP_VARIANT=development
# Set to 1 only with EXPO_PUBLIC_API_ENV=local in a development/internal build.
LISNO_ALLOW_LOCAL_HTTP=0
# Required only for production builds after the application ID is approved.
# LISNO_ANDROID_PACKAGE=com.yourcompany.lisno

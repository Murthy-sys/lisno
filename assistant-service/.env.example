# Server deployment only. Never use a developer laptop as the model host.
ASSISTANT_SERVICE_TOKEN=
ASSISTANT_MODEL_URL=http://127.0.0.1:11434
ASSISTANT_MODEL_NAME=
ASSISTANT_MODEL_DIGEST=
ASSISTANT_MAX_CONCURRENCY=2
ASSISTANT_REQUEST_TIMEOUT_MS=19000
OLLAMA_NO_CLOUD=1
# deployment/compose.yaml requires preinstalled immutable images/artifacts:
OLLAMA_IMAGE=
ASSISTANT_IMAGE=
PINNED_MODEL_DIRECTORY=

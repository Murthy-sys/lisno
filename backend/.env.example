# HTTP port and transaction-capable Mongo replica-set connection. `npm run dev`,
# `npm start`, and `npm run seed` load backend/.env automatically.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lisno?replicaSet=rs0
# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173
# Relative paths resolve from the backend workspace.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
# Seconds a worker may hold an OCR extraction job before the lease can be reclaimed.
OCR_LEASE_SECONDS=300
# Shared only with the Python OCR worker; never expose this value to browser code.
OCR_WORKER_TOKEN=replace-with-a-separate-long-worker-token

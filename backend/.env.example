# HTTP port and transaction-capable Mongo replica-set connection.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/lisno?replicaSet=rs0
# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
# Relative paths resolve from the backend workspace.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25

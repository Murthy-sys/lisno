# HTTP port and transaction-capable Mongo replica-set connection. `npm run dev`,
# `npm start`, and `npm run seed` load backend/.env automatically.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lisno_demo?replicaSet=rs0
# Demo reset is fail-closed. Set this to true only in the shell for an intended
# local reset; DEMO_SEED_DATABASE must exactly match the URI database.
ALLOW_DEMO_SEED=false
DEMO_SEED_DATABASE=lisno_demo
# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173
# Invitation email delivery is disabled only when this entire group is absent.
# When enabled, PUBLIC_FRONTEND_URL must be an HTTPS origin and TLS certificate
# verification is always required. SMTP_TLS_MODE is `implicit` or `starttls`.
PUBLIC_FRONTEND_URL=https://app.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Lisno Invitations <invitations@example.com>
# Relative paths resolve from the backend workspace.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
# Seconds a worker may hold an OCR extraction job before the lease can be reclaimed.
OCR_LEASE_SECONDS=300
# Retry policy in seconds. The cap must be at least the initial delay.
OCR_MAX_ATTEMPTS=5
OCR_RETRY_INITIAL_SECONDS=30
OCR_RETRY_MAX_SECONDS=900
OCR_CONFIDENCE_FLOOR=0.2
# Shared only with the Python OCR worker; never expose this value to browser code.
OCR_WORKER_TOKEN=replace-with-a-separate-long-worker-token
# Worker process settings (set these in the worker shell, not browser code).
OCR_API_BASE_URL=http://127.0.0.1:3000/api/v1
OCR_POLL_SECONDS=5
OCR_REQUEST_TIMEOUT_SECONDS=60
# Worker-side resource ceilings. Keep heartbeat comfortably below OCR_LEASE_SECONDS.
OCR_MAX_PDF_PAGES=50
OCR_MAX_PAGE_PIXELS=40000000
OCR_MAX_OUTPUT_BYTES=41943040
OCR_MAX_PROCESSING_SECONDS=900

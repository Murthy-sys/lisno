# HTTP port and transaction-capable Mongo replica-set connection. `npm run dev`,
# `npm start`, and `npm run seed` load backend/.env automatically.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/lisno_demo?replicaSet=rs0
# Demo reset is fail-closed. Set this to true only in the shell for an intended
# local reset; DEMO_SEED_DATABASE must exactly match the URI database.
ALLOW_DEMO_SEED=false
DEMO_SEED_DATABASE=lisno_demo
# Use a random value of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173
# Staff invitations and Estimate attachments share this complete, all-or-nothing
# group. SMTP_FROM is the general Lisno sender for staff invitations and Estimate
# attachments. Certificate verification cannot be disabled; SMTP_TLS_MODE is
# `implicit` or `starttls`.
# When the entire group is absent, external mail is disabled. Estimate publication
# still succeeds into the Client portal, records a safe delivery state, and permits
# an explicit owner or Super Admin retry of the same stored PDF after disabled or
# failed SMTP delivery.
# The initiating active Admin receives the Client-response task; otherwise the sole
# active Super Admin does. Admin Approve or Reject requires one PDF, JPEG, PNG, or
# WebP proof, and Reject means Request changes.
# Existing Client Dashboard, PDF, Approve, Request changes, drawing, and plan behavior
# remains unchanged, and historical records are not backfilled.
# Remote production requires HTTPS for both PUBLIC_FRONTEND_URL and the API. The
# generated /client portal link carries no token, email, Estimate ID, or credential.
PUBLIC_FRONTEND_URL=https://app.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Lisno <notifications@example.com>
# Relative paths resolve from the backend workspace.
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
# Seconds a worker may hold an OCR extraction job before the lease can be reclaimed.
OCR_LEASE_SECONDS=300
# Retry policy in seconds. The cap must be at least the initial delay.
OCR_MAX_ATTEMPTS=5
OCR_RETRY_INITIAL_SECONDS=30
OCR_RETRY_MAX_SECONDS=900
OCR_CONFIDENCE_FLOOR=0.2
# Shared only with the Python OCR worker; never expose this value to browser code.
OCR_WORKER_TOKEN=replace-with-a-separate-long-worker-token
# Worker process settings (set these in the worker shell, not browser code).
OCR_API_BASE_URL=http://127.0.0.1:3000/api/v1
OCR_POLL_SECONDS=5
OCR_REQUEST_TIMEOUT_SECONDS=60
# Worker-side resource ceilings. Keep heartbeat comfortably below OCR_LEASE_SECONDS.
OCR_MAX_PDF_PAGES=50
OCR_MAX_PAGE_PIXELS=40000000
OCR_MAX_OUTPUT_BYTES=41943040
OCR_MAX_PROCESSING_SECONDS=900

# LOCAL TESTING ONLY. Permits the seeded development demo Super Admin to send
# real external email. Never enable in production: the demo account password
# ships in the repository, so anyone with the source could send mail as you.
ALLOW_DEMO_ACCOUNT_EXTERNAL_EMAIL=false
